// Cloudflare: web ze složky "web" + malý worker pro asistenta AmorAI (Workers AI, bezplatný denní limit)
{
  "name": "plaminek",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" }
}
